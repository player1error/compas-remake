{
  "name": "codekompas",
  "version": "0.2.3",
  "description": "%description%",
  "main": "./dist/extension.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "package": "vsce package --no-dependencies --allow-missing-repository",
    "bundle": "node scripts/bundle.js",
    "vscode:prepublish": "npm run bundle"
  },
  "keywords": [],
  "author": "Joris Petillion",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "acorn": "^8.19.0",
    "acorn-loose": "^8.5.2",
    "acorn-walk": "^8.3.5",
    "eslint-scope": "^8.4.0",
    "parse5": "^7.3.0",
    "postcss": "^8.5.31",
    "postcss-safe-parser": "^7.1.0",
    "postcss-value-parser": "^4.2.0",
    "vscode-css-languageservice": "^6.3.10",
    "vscode-html-languageservice": "^5.6.2",
    "vscode-languageserver-textdocument": "^1.0.15"
  },
  "displayName": "%displayName%",
  "publisher": "codekompas",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Education",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:html",
    "onLanguage:css",
    "onLanguage:javascript"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "%untrusted%"
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "commands": [
      {
        "command": "codekompas.open",
        "title": "%codekompas.open%"
      },
      {
        "command": "codekompas.analyze",
        "title": "%codekompas.analyze%"
      },
      {
        "command": "codekompas.pause",
        "title": "%codekompas.pause%"
      },
      {
        "command": "codekompas.resetIgnored",
        "title": "%codekompas.resetIgnored%"
      },
      {
        "command": "codekompas.toggleLanguage",
        "title": "%codekompas.toggleLanguage%"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codekompas",
          "title": "CodeKompas",
          "icon": "media/compass.svg"
        }
      ]
    },
    "views": {
      "codekompas": [
        {
          "type": "webview",
          "id": "codekompas.panel",
          "name": "%panel%"
        }
      ]
    },
    "configuration": {
      "title": "CodeKompas",
      "properties": {
        "codekompas.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%codekompas.enabled%"
        },
        "codekompas.principles": {
          "type": "boolean",
          "default": true,
          "description": "%codekompas.principles%"
        },
        "codekompas.maxHints": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "maximum": 100,
          "description": "%codekompas.maxHints%"
        },
        "codekompas.delay": {
          "type": "number",
          "default": 900,
          "minimum": 200,
          "maximum": 5000,
          "description": "%codekompas.delay%"
        },
        "codekompas.maxCharacters": {
          "type": "number",
          "default": 250000,
          "minimum": 1000,
          "maximum": 1000000,
          "description": "%codekompas.maxCharacters%"
        },
        "codekompas.ignoreWords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%codekompas.ignoreWords%"
        },
        "codekompas.disabledPrinciples": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "naming",
              "callbacks",
              "collections",
              "equality",
              "templates",
              "destructuring",
              "selectors",
              "boxmodel",
              "units",
              "semantics",
              "accessibility",
              "styling",
              "functions",
              "arrays",
              "objects",
              "conditions",
              "loops",
              "dom",
              "json",
              "async",
              "scope",
              "layout",
              "cascade",
              "es6",
              "dry",
              "tokens",
              "bem",
              "components",
              "gestalt",
              "events"
            ]
          },
          "default": [],
          "description": "%codekompas.disabledPrinciples%"
        },
        "codekompas.maxPrinciples": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "maximum": 30,
          "description": "%codekompas.maxPrinciples%"
        },
        "codekompas.styleConventions": {
          "type": "boolean",
          "default": true,
          "description": "%codekompas.styleConventions%"
        },
        "codekompas.indentationHints": {
          "type": "boolean",
          "default": true,
          "description": "%codekompas.indentationHints%"
        }
      }
    }
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0"
  }
}
